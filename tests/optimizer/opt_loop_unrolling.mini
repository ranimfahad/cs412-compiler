// opt_loop_unrolling.mini -- unrolling for loops with constant bounds.

void main() {
    int i;
    int sum = 0;

    // 4 iterations: fully unrolled, then folded to a constant
    for (i = 0; i < 4; i = i + 1) {
        sum = sum + i;
    }
    print(sum);

    // 32 iterations: too many to unroll fully, so the body is repeated
    // 4 times inside the loop (the test and jump run 8 times, not 32)
    int total = 0;
    for (i = 1; i <= 32; i = i + 1) {
        total = total + i * 2;
    }
    print(total);

    // counting down by 3: 10, 7, 4, 1 -> fully unrolled
    for (i = 10; i > 0; i = i - 3) {
        print(i);
    }

    // the bound is a variable: not unrolled
    int n = 5;
    int k;
    for (k = 0; k < n; k = k + 1) {
        sum = sum + k;
    }
    print(sum);
}
