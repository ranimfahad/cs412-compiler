end sum_scaled

function nested(n, m):
    s = 0
    i = 0
    t3 = m * n
L1:
    t1 = i < n
    ifFalse t1 goto L2
    j = 0
    t5 = i << 1
L3:
    t2 = j < m
    ifFalse t2 goto L4
    t4 = s + t3
    s = t4 + t5
    j = j + 1
    goto L3
L4:
    i = i + 1
    goto L1
L2:
    return s
