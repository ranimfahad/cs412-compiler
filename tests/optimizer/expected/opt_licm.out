function sum_scaled(n, k):
    total = 0
    i = 0
    t2 = k * 3
    t4 = n / 2
L1:
    t1 = i < n
    ifFalse t1 goto L2
    t3 = total + t2
    total = t3 + t4
    t5 = 100 / k
    total = total + t5
    i = i + 1
    goto L1
L2:
    return total
