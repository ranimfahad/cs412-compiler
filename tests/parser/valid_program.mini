// valid_program.mini -- a complete program using every kind of statement.

int limit = 5;
float scale = 2.5;
bool verbose;

int fact(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * fact(n - 1);
}

float average(int a, int b) {
    return (a + b) / 2.0;
}

void report(int value) {
    print(value);
    return;
}

void main() {
    int i;
    bool done = false;

    for (i = 0; i < limit; i = i + 1) {
        print(fact(i));
    }

    while (!done) {
        i = i - 1;
        if (i == 2) {
            done = true;
        } else {
            report(i);
        }
    }

    print(average(i, 10) * scale);
}
